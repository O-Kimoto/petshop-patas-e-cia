{
    "name": "Petshop Fullstack",
    "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "postCreateCommand": "npm run setup",
    "postStartCommand": "sh .devcontainer/iniciar.sh",
    "forwardPorts": [3000],
    "portsAttributes": {
        "3000": {
            "label": "Petshop (front + API + Swagger)",
            "onAutoForward": "openBrowser"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": ["angular.ng-template"]
        }
    }
}
