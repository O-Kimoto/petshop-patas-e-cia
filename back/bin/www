#!/usr/bin/env node

var http = require('http');
var app = require('../app');
var { ready } = require('../db/database');
var seed = require('../db/seed');

var port = parseInt(process.env.PORT, 10) || 3000;
app.set('port', port);

// Só abre a porta depois que as tabelas existem e o usuário inicial foi criado - [Otávio Michels]
ready
  .then(seed)
  .then(function () {
    var server = http.createServer(app);
    server.listen(port, function () {
      console.log('API Petshop rodando em http://localhost:' + port);
      console.log('Swagger em http://localhost:' + port + '/api-docs');
    });
    server.on('error', function (error) {
      if (error.code === 'EADDRINUSE') {
        console.error('A porta ' + port + ' já está em uso');
        process.exit(1);
      }
      throw error;
    });
  })
  .catch(function (err) {
    console.error('Erro ao preparar o banco de dados:', err);
    process.exit(1);
  });
