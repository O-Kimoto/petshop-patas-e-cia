PORT=3000
# Gere uma chave longa e aleatória (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=troque_por_uma_chave_aleatoria
JWT_EXPIRES_IN=1d
# Origens liberadas no CORS, separadas por vírgula (deixe vazio para liberar todas)
CORS_ORIGIN=
# Usuário criado automaticamente quando o banco está vazio.
# O "npm run setup" troca esta senha por uma aleatória e mostra no terminal.
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
# "Criar conta" na tela de login: nao = só um usuário logado cria contas (tela de Usuários); sim = qualquer pessoa.
# Toda conta tem acesso total, então só ligue (sim) se o sistema não estiver aberto na internet.
CADASTRO_PUBLICO=nao
